# Gemini powers triage and the assistant. Without a key the service still runs on its rule engine.
GEMINI_API_KEY=
# Optional alternative provider
ANTHROPIC_API_KEY=
# Model order to try; overloaded models are skipped for two minutes
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash,gemini-3.1-flash-lite
