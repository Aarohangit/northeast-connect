# Gateway that also serves the citizen app (/) and control room (/admin).
# Build context is the repository root.
FROM node:22-alpine AS web
WORKDIR /web
COPY citizen-app/package.json citizen-app/package-lock.json citizen-app/
COPY admin-console/package.json admin-console/package-lock.json admin-console/
# npm install, not npm ci: the lockfile is made on Windows and lacks some Linux-only optional packages.
RUN cd citizen-app && npm install --no-audit --no-fund && cd ../admin-console && npm install --no-audit --no-fund
COPY citizen-app citizen-app
COPY admin-console admin-console
# Empty API URL: the apps call /api on the same origin.
ENV VITE_API_URL=""
RUN cd citizen-app && npm run build && cd ../admin-console && ADMIN_BASE=/admin/ npm run build

FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /app
COPY services/api-gateway/pom.xml .
RUN mvn -q -B dependency:go-offline
COPY services/api-gateway/src src
COPY --from=web /web/citizen-app/dist src/main/resources/static
COPY --from=web /web/admin-console/dist src/main/resources/static/admin
RUN mvn -q -B -DskipTests package && cp target/*.jar app.jar

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /app/app.jar app.jar
ENV JAVA_OPTS="-Xmx320m -XX:+UseSerialGC -XX:TieredStopAtLevel=1"
CMD ["sh", "-c", "exec java $JAVA_OPTS -Dserver.port=${PORT:-8090} -jar app.jar"]
